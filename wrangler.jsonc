{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hark",
  "main": "src/index.ts",
  // Private by default: hark spends each person's own Workers AI, so there is no workers.dev or preview URL.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "worker_loaders": [{ "binding": "LOADER" }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [
      { "name": "HARK", "class_name": "Hark" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hark", "Directory"] }]
}
